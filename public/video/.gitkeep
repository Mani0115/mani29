* {
  box-sizing: border-box;
}

:root {
  --bg: #070b16;
  --bg-soft: #0f172a;
  --panel: rgba(15, 23, 42, 0.8);
  --panel-strong: rgba(17, 24, 39, 0.9);
  --card: rgba(148, 163, 184, 0.08);
  --card-border: rgba(148, 163, 184, 0.18);
  --text: #edf2ff;
  --muted: #c8d2ea;
  --accent: #7c9cff;
  --accent-strong: #a78bfa;
  --shadow: 0 24px 80px rgba(15, 23, 42, 0.5);
  --radius: 24px;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: 'Manrope', 'HelveticaNowDisplayW01-Rg', sans-serif;
  background:
    radial-gradient(circle at top left, rgba(124, 156, 255, 0.2), transparent 28%),
    radial-gradient(circle at bottom right, rgba(167, 139, 250, 0.12), transparent 22%),
    var(--bg);
  color: var(--text);
}

a {
  color: inherit;
  text-decoration: none;
}

img,
video {
  max-width: 100%;
  display: block;
}

#root {
  width: 100%;
}

.page-shell {
  width: min(1200px, calc(100% - 32px));
  margin: 0 auto;
  padding: 24px 0 56px;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 18px 24px;
  border: 1px solid var(--card-border);
  border-radius: 999px;
  background: rgba(15, 23, 42, 0.65);
  backdrop-filter: blur(14px);
  position: sticky;
  top: 18px;
  z-index: 10;
}

.brand-wrap {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand-mark {
  width: 42px;
  height: 42px;
  border-radius: 14px;
  display: grid;
  place-items: center;
  font-weight: 800;
  background: linear-gradient(135deg, var(--accent), var(--accent-strong));
  box-shadow: var(--shadow);
}

.brand-name,
.brand-role {
  margin: 0;
  line-height: 1.2;
}

.brand-name {
  font-weight: 700;
  font-size: 0.95rem;
}

.brand-role {
  font-size: 0.72rem;
  color: var(--muted);
}

.nav {
  display: flex;
  align-items: center;
  gap: 20px;
  color: var(--muted);
  font-size: 0.92rem;
}

.nav a {
  transition: color 0.2s ease;
}

.nav a:hover,
.nav a:focus-visible {
  color: var(--text);
}

.hero {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  align-items: center;
  gap: 34px;
  padding: 72px 0 40px;
}

.eyebrow,
.section-tag {
  margin: 0 0 18px;
  color: #a5b4ff;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  font-size: 0.7rem;
  font-weight: 700;
}

.hero-copy h1 {
  margin: 0;
  font-size: clamp(2.8rem, 5vw, 5rem);
  line-height: 0.96;
  letter-spacing: -0.06em;
}

.hero-text {
  margin: 22px 0 0;
  max-width: 620px;
  color: var(--muted);
  font-size: 1.08rem;
  line-height: 1.8;
}

.cta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin-top: 28px;
}

.primary-btn,
.secondary-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 52px;
  padding: 0 22px;
  border-radius: 999px;
  font-weight: 700;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.primary-btn {
  background: linear-gradient(135deg, var(--accent), var(--accent-strong));
  box-shadow: 0 18px 45px rgba(124, 156, 255, 0.36);
}

.secondary-btn {
  border: 1px solid var(--card-border);
  background: rgba(148, 163, 184, 0.04);
}

.primary-btn:hover,
.secondary-btn:hover,
.primary-btn:focus-visible,
.secondary-btn:focus-visible {
  transform: translateY(-1px);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(120px, 1fr));
  gap: 16px;
  margin-top: 32px;
}

.stat-card {
  padding: 18px 16px;
  border-radius: 18px;
  border: 1px solid var(--card-border);
  background: rgba(148, 163, 184, 0.04);
}

.stat-card strong {
  display: block;
  font-size: clamp(1.4rem, 2vw, 2rem);
  margin-bottom: 8px;
}

.stat-card span {
  color: var(--muted);
  font-size: 0.82rem;
  line-height: 1.5;
}

.hero-visual {
  display: flex;
  justify-content: center;
}

.device-frame {
  position: relative;
  width: min(480px, 100%);
  min-height: 560px;
  border-radius: 32px;
  padding: 18px;
  background: linear-gradient(180deg, rgba(15, 23, 42, 0.9), rgba(15, 23, 42, 0.68));
  border: 1px solid var(--card-border);
  box-shadow: var(--shadow);
  overflow: hidden;
}

.hero-video {
  width: 100%;
  height: 100%;
  min-height: 510px;
  object-fit: cover;
  border-radius: 24px;
  background: linear-gradient(135deg, #0f172a, #1e293b);
}

.device-overlay {
  position: absolute;
  inset: 18px 18px 18px 18px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  pointer-events: none;
  padding: 18px;
  border-radius: 26px;
  background: linear-gradient(180deg, rgba(8, 10, 16, 0.14), rgba(8, 10, 16, 0.45));
}

.device-header {
  display: flex;
  gap: 8px;
}

.dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  display: inline-block;
}

.dot.red { background: #ff5f57; }
.dot.yellow { background: #ffbd2e; }
.dot.green { background: #28c840; }

.screen-content {
  max-width: 230px;
  padding: 18px 18px 16px;
  border-radius: 18px;
  background: rgba(9, 12, 24, 0.52);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.mini-label {
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: #dfe7ff;
}

.screen-content h3 {
  margin: 10px 0 12px;
  font-size: 1.7rem;
  line-height: 1.15;
}

.screen-content ul {
  margin: 0;
  padding-left: 18px;
  color: var(--muted);
  line-height: 1.9;
}

.content-section {
  margin-top: 52px;
  padding: 28px 0;
}

.section-heading {
  margin-bottom: 22px;
}

.section-heading h2,
.intro-wrap h2,
.footer h2 {
  margin: 0;
  font-size: clamp(2rem, 3vw, 3rem);
  line-height: 1.08;
  letter-spacing: -0.05em;
}

.intro-wrap {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 28px;
  align-items: end;
}

.intro-wrap p:last-child {
  margin: 0;
  color: var(--muted);
  line-height: 1.9;
  font-size: 1.04rem;
}

.card-grid,
.project-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.info-card,
.project-card {
  padding: 24px 20px;
  border-radius: var(--radius);
  background: rgba(148, 163, 184, 0.04);
  border: 1px solid var(--card-border);
}

.card-icon {
  width: 46px;
  height: 46px;
  display: grid;
  place-items: center;
  border-radius: 14px;
  margin-bottom: 18px;
  background: linear-gradient(135deg, rgba(124, 156, 255, 0.2), rgba(167, 139, 250, 0.2));
  font-size: 1.25rem;
}

.info-card h3 {
  margin: 0 0 12px;
  font-size: 1.4rem;
}

.info-card p {
  margin: 0;
  color: var(--muted);
  line-height: 1.8;
}

.alt-panel {
  padding: 32px 20px;
  border-radius: 30px;
  border: 1px solid var(--card-border);
  background: linear-gradient(180deg, rgba(17, 24, 39, 0.9), rgba(17, 24, 39, 0.7));
}

.process-list {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
  margin-top: 24px;
}

.process-step {
  padding: 18px 16px;
  border-radius: 18px;
  border: 1px solid var(--card-border);
  background: rgba(148, 163, 184, 0.03);
}

.process-step span {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: rgba(124, 156, 255, 0.2);
  color: #dfe6ff;
  font-weight: 800;
  margin-bottom: 12px;
}

.process-step p {
  margin: 0;
  color: var(--muted);
  line-height: 1.8;
}

.project-card {
  min-height: 160px;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  background: linear-gradient(180deg, rgba(124, 156, 255, 0.1), rgba(148, 163, 184, 0.03));
}

.project-card p {
  margin: 0 0 12px;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-size: 0.72rem;
}

.project-card strong {
  font-size: 1.45rem;
  line-height: 1.3;
}

.footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-top: 54px;
  padding-top: 24px;
  border-top: 1px solid var(--card-border);
}

@media (max-width: 900px) {
  .hero,
  .intro-wrap,
  .card-grid,
  .project-grid,
  .process-list,
  .footer {
    grid-template-columns: 1fr;
    display: grid;
  }

  .topbar {
    border-radius: 28px;
    padding: 18px 18px;
    flex-direction: column;
    align-items: flex-start;
  }

  .nav {
    flex-wrap: wrap;
    gap: 12px 18px;
  }

  .hero {
    padding-top: 48px;
  }

  .device-frame {
    min-height: 420px;
  }

  .hero-video {
    min-height: 360px;
  }

  .footer {
    display: grid;
    align-items: start;
  }
}

@media (max-width: 560px) {
  .page-shell {
    width: min(100% - 20px, 1200px);
  }

  .brand-name {
    font-size: 0.82rem;
  }

  .stats-grid {
    grid-template-columns: 1fr;
  }

  .cta-row {
    flex-direction: column;
    align-items: stretch;
  }

  .primary-btn,
  .secondary-btn {
    width: 100%;
  }

  .hero-copy h1 {
    font-size: 2.7rem;
  }
}
